// Uitbreiding: BRT Achtergrondkaart + BGT als één kaartlaag, inzoomen tot zoomniveau 19.
// Hernoem dit bestand naar main.js (bewaar het origineel eerst!) om het resultaat te zien.

// 1. Maak de projectie RD New (EPSG:28992) bekend bij OpenLayers, met behulp van proj4js
proj4.defs('EPSG:28992', '+proj=sterea +lat_0=52.1561605555556 +lon_0=5.38763888888889 +k=0.9999079 +x_0=155000 +y_0=463000 +ellps=bessel +towgs84=565.4171,50.3319,465.5524,-0.398957388243,0.343987817378,-1.87740163998,4.0725 +units=m +no_defs');
ol.proj.proj4.register(proj4);
const rd = ol.proj.get('EPSG:28992');
const rd_tile_matrix_extent = [-285401.92, 22598.08, 595401.92, 903401.92];
rd.setExtent(rd_tile_matrix_extent);

// 2. De NetherlandsRDNewQuad Tile Matrix Set, zie
//    https://api.pdok.nl/kadaster/brt-achtergrondkaart/ogc/v1/tileMatrixSets/NetherlandsRDNewQuad
//    De Tile Matrix Set loopt door tot en met zoomniveau 16; de kaart laten we verder
//    inzoomen, tot en met zoomniveau 19. Daarom berekenen we de resoluties tot en met 19.
const resolutions = [];
for (let z = 0; z <= 19; z++) {
    resolutions.push(3440.64 / Math.pow(2, z)); // cellSize van zoomniveau z
}

// De tegels zelf zijn alleen beschikbaar tot en met zoomniveau 12.
// Bij verder inzoomen hergebruikt OpenLayers de tegels van niveau 12 ("overzoomen").
const tileResolutions = resolutions.slice(0, 13); // zoomniveau 0 t/m 12

// Tegelschema voor de BRT Achtergrondkaart: tegels op zoomniveau 0 t/m 12
const brtTileGrid = new ol.tilegrid.TileGrid({
    extent: rd_tile_matrix_extent, // tegel 0/0/0 beslaat precies dit gebied
    origin: [-285401.92, 903401.92], // linkerbovenhoek van tegel 0/0/0
    resolutions: tileResolutions,
    tileSize: 256
});

// Tegelschema voor de BGT: hetzelfde schema, maar er zijn alleen tegels op zoomniveau 12,
// zie tileMatrixSetLimits in https://api.pdok.nl/kadaster/bgt/ogc/v1/tiles/NetherlandsRDNewQuad?f=json
const bgtTileGrid = new ol.tilegrid.TileGrid({
    extent: rd_tile_matrix_extent,
    origin: [-285401.92, 903401.92],
    resolutions: tileResolutions,
    minZoom: 12, // vraag nooit tegels op van een lager zoomniveau
    tileSize: 256
});

// Het omslagpunt tussen BRT en BGT: de resolutie van zoomniveau 12.
// Zoomniveau 12 en lager: BRT. Zoomniveau 13 en hoger: BGT.
const omslagResolutie = resolutions[12];

// 3. OGC API - Tiles: de BRT Achtergrondkaart als vector tiles
const brt = new ol.layer.VectorTile({
    declutter: true,
    minResolution: omslagResolutie, // zichtbaar zolang resolutie >= omslagResolutie (t/m niveau 12)
    source: new ol.source.VectorTile({
        format: new ol.format.MVT(), // het Mapbox Vector Tile formaat
        projection: rd,
        tileGrid: brtTileGrid,
        url: 'https://api.pdok.nl/kadaster/brt-achtergrondkaart/ogc/v1/tiles/NetherlandsRDNewQuad/{z}/{y}/{x}?f=mvt'
    })
});

olms.applyStyle(
    brt,
    'https://api.pdok.nl/kadaster/brt-achtergrondkaart/ogc/v1/styles/standaard__netherlandsrdnewquad?f=json',
    { updateSource: false, resolutions: resolutions }
);

// 4. OGC API - Tiles: de Basisregistratie Grootschalige Topografie (BGT) als vector tiles
const bgt = new ol.layer.VectorTile({
    declutter: true,
    maxResolution: omslagResolutie, // zichtbaar zolang resolutie < omslagResolutie (vanaf niveau 13)
    source: new ol.source.VectorTile({
        format: new ol.format.MVT(),
        projection: rd,
        tileGrid: bgtTileGrid,
        url: 'https://api.pdok.nl/kadaster/bgt/ogc/v1/tiles/NetherlandsRDNewQuad/{z}/{y}/{x}?f=mvt'
    })
});

olms.applyStyle(
    bgt,
    'https://api.pdok.nl/kadaster/bgt/ogc/v1/styles/bgt_achtergrondvisualisatie__netherlandsrdnewquad?f=json',
    { updateSource: false, resolutions: resolutions }
);

// 5. Voeg BRT en BGT samen in één LayerGroup, die als één kaartlaag werkt.
//    De min- en maxResolution van de groep gelden voor alle lagen erin:
//    de groep is zichtbaar van zoomniveau 2 tot en met 19.
const basiskaart = new ol.layer.Group({
    layers: [brt, bgt],
    maxResolution: resolutions[1], // zichtbaar zolang resolutie < die van niveau 1 (vanaf niveau 2)
    minResolution: resolutions[19] // zichtbaar zolang resolutie >= die van niveau 19 (t/m niveau 19)
});

// 6. De kaart zelf
const map = new ol.Map({
    target: 'map',
    layers: [basiskaart],
    view: new ol.View({
        projection: rd,
        resolutions: resolutions, // alleen zoomen naar de zoomniveaus 0 t/m 19
        center: [155000, 463000], // De RD-coördinaten van de Onze Lieve Vrouwetoren in Amersfoort
        zoom: 2, // initieel zoomniveau
        minZoom: 2, // maximaal uitzoomen
        maxZoom: 19, // maximaal inzoomen
        extent: rd_tile_matrix_extent,
    })
});

// Toon het zoomniveau en de resolutie in de console, handig om het omslagpunt te zien
// 'moveend' vuurt één keer, nadat de zoom-animatie klaar is
// ('change:resolution' vuurt bij elke tussenstap van de animatie).
// 'moveend' vuurt ook na het verslepen van de kaart, dus loggen we alleen als het zoomniveau veranderd is.
let vorigeZoom;
map.on('moveend', () => {
    const view = map.getView();
    const zoom = view.getZoom();
    if (zoom !== vorigeZoom) {
        console.log('zoomniveau:', zoom, 'resolutie:', view.getResolution());
        vorigeZoom = zoom;
    }
});

map.on('click', (event) => {
    console.log(event.coordinate);
});
